<% photos = [
  "DSC04291.webp",
  "DSC04293.webp",
  "DSC04300.webp",
  "DSC04305.webp",
  "DSC04319.webp",
  "BW Prime_SM Oct_1.webp"
] %>
<% videos = [
  "boardwalk-prime-hero-video-steak.mp4",
  "Boardwalk Prime - Website Landing Page Video.mp4"
] %>

<main class="bp-splash" data-bp-splash>
  <div class="bp-media-stage" aria-hidden="true">
    <% videos.each_with_index do |video, index| %>
      <video
        class="bp-media-item <%= "is-active" if index.zero? %>"
        data-bp-media
        data-bp-kind="video"
        muted
        playsinline
        preload="metadata"
      >
        <source src="<%= asset_path(video) %>" type="video/mp4">
      </video>
    <% end %>

    <% photos.each do |photo| %>
      <%= image_tag photo,
        class: "bp-media-item",
        data: { bp_media: true, bp_kind: "image" },
        alt: "" %>
    <% end %>
  </div>

  <div class="bp-atmosphere" aria-hidden="true"></div>

  <section class="bp-splash-content" aria-labelledby="bp-title">
    <p class="bp-kicker">Antigua's newest steak &amp; seafood house</p>

    <%= image_tag "boardwalk-prime-logo-2-transparent.webp",
      class: "bp-logo",
      alt: "Boardwalk Prime Steak and Seafood",
      id: "bp-title" %>

    <div class="bp-rule" aria-hidden="true"></div>

    <p class="bp-intro">
      Prime cuts, pristine seafood, and tableside theatre arriving at the water's edge.
    </p>

    <div class="bp-countdown" data-bp-countdown data-bp-opening="2026-10-30T00:00:00-04:00" role="group" aria-label="Countdown to opening on October 30, 2026" hidden>
      <% %w[days hours minutes seconds].each do |unit| %>
        <div class="bp-countdown-unit">
          <span class="bp-countdown-number" data-bp-countdown-<%= unit %>>00</span>
          <span class="bp-countdown-label"><%= unit %></span>
        </div>
      <% end %>
    </div>

    <p class="bp-opening-date"><time datetime="2026-10-30">October 30, 2026 Opening</time></p>

    <a class="bp-book-button" href="https://www.opentable.com/booking/restref/availability?rid=1558858&amp;restref=1558858&amp;lang=en-US&amp;ot_source=Restaurant%20website" target="_blank" rel="noopener noreferrer">Book a Table</a>

    <div class="bp-secondary-links">
      <button class="bp-about-button" type="button" data-bp-modal-open="bp-newsletter-modal" aria-haspopup="dialog" aria-controls="bp-newsletter-modal">Join Newsletter <span aria-hidden="true">↗</span></button>
      <button class="bp-about-button" type="button" data-bp-modal-open="bp-about-modal" aria-haspopup="dialog" aria-controls="bp-about-modal">About Us <span aria-hidden="true">↗</span></button>
    </div>

    <p class="bp-hours">Sun–Sat 4:30–10:00pm</p>

    <p class="bp-address">
      Redcliffe Quay, St John's, Antigua
    </p>
  </section>

  <div class="bp-toast" data-bp-toast role="status" aria-live="polite">
    Thank you for your e-mail. We'll be in touch!
  </div>
</main>

<dialog class="bp-newsletter-modal" id="bp-newsletter-modal" aria-label="Newsletter signup" data-bp-modal>
  <div class="bp-modal-header">
    <form method="dialog">
      <button class="bp-modal-close" aria-label="Close newsletter signup" autofocus>&times;</button>
    </form>
  </div>
  <div class="bp-newsletter">
    <iframe
      class="bp-newsletter-frame"
      data-src="https://www.opentable.com/widget/comms/mural?rid=1558858&amp;lang=en-US"
      title="Join the Boardwalk Prime newsletter"
      width="610"
      height="1100"
      scrolling="no"
    ></iframe>
  </div>
</dialog>

<dialog class="bp-about-modal" id="bp-about-modal" aria-labelledby="bp-about-title" data-bp-modal>
  <div class="bp-about-panel">
    <%= image_tag "DSC04293.webp", class: "bp-about-backdrop", alt: "", loading: "lazy" %>
    <div class="bp-about-close-bar">
      <form method="dialog">
        <button class="bp-modal-close" aria-label="Close About Us" autofocus>&times;</button>
      </form>
    </div>
    <article class="bp-about-copy">
      <p class="bp-about-eyebrow">Redcliffe Quay · Antigua</p>
      <h2 id="bp-about-title">About Boardwalk Prime</h2>
      <div class="bp-about-rule" aria-hidden="true"></div>
      <p>Located on the waterfront in historic <strong>Redcliffe Quay, St. John’s</strong>, Boardwalk Prime overlooks the Caribbean and the bustle of Antigua’s cruise harbour, bringing together exceptional food, premium drinks and the unmistakable energy of the island.</p>
      <p>At its heart, Boardwalk Prime is a contemporary steak and seafood restaurant, showcasing outstanding produce, beautifully prepared steaks, fresh local seafood and bold flavours from the grill. Quality is uncompromising — from the ingredients on the plate to an expertly selected wine list, premium spirits and beautifully crafted cocktails.</p>
      <p>Boardwalk Prime transforms throughout the day. Arrive for relaxed drinks, stay for dinner and watch the Caribbean sunset give way to an evening of live music, cocktails and a lively atmosphere.</p>
      <p>The setting combines the sophistication of crisp, table-clothed dining and exceptional service with the warmth and energy of the Caribbean. Whether it’s an intimate dinner for two, an evening with friends and family, a celebration, corporate gathering or a larger party, Boardwalk Prime is designed for occasions of every kind.</p>
      <p>And when dinner is over, the evening can continue downstairs at <strong>Boardwalk Casino</strong>, bringing gaming and entertainment together with the restaurant, music and nightlife all in one destination.</p>
      <p>Enjoy a perfectly cooked steak. Share fresh seafood. Order another cocktail. Listen to the music and take in the view.</p>
      <p class="bp-about-statement"><strong>Boardwalk Prime is more than somewhere to eat — it’s somewhere to spend the evening.</strong></p>
      <p class="bp-about-signature"><strong>Prime food. Prime drinks. Prime location. Prime entertainment.</strong></p>
      <p class="bp-about-welcome"><strong>Welcome to Boardwalk Prime, Antigua.</strong></p>
    </article>
  </div>
</dialog>

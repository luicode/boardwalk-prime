<script nonce="<%= content_security_policy_nonce %>">
  function initBpMenuTabs() {
    const tabs = document.querySelectorAll("[data-bp-tab]");
    const panels = document.querySelectorAll("[data-bp-panel]");
    if (!tabs.length || !panels.length) return;

    const showPanel = (key, clickedBtn) => {
      panels.forEach((p) => p.classList.toggle("d-none", p.dataset.bpPanel !== key));

      tabs.forEach((b) => {
        b.classList.remove("btn-light");
        b.classList.add("btn-outline-light");
      });

      clickedBtn.classList.remove("btn-outline-light");
      clickedBtn.classList.add("btn-light");
    };

    tabs.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        showPanel(btn.dataset.bpTab, btn);
      });
    });
  }

  // Works whether Turbo is present or not
  document.addEventListener("turbo:load", initBpMenuTabs);
  document.addEventListener("DOMContentLoaded", initBpMenuTabs);
</script>

<script nonce="<%= content_security_policy_nonce %>">
  function initBpWordmark() {
    const wm = document.getElementById("bpWordmark");
    if (!wm) return;

    // reset (helps Turbo visits)
    wm.classList.remove("bp-in");
    requestAnimationFrame(() => {
      requestAnimationFrame(() => wm.classList.add("bp-in"));
    });
  }

  document.addEventListener("turbo:load", initBpWordmark);
  document.addEventListener("DOMContentLoaded", initBpWordmark);
</script>

<script nonce="<%= content_security_policy_nonce %>">
  function initBpFooterSmoothScroll(){
    document.querySelectorAll('a[href^="#"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = a.getAttribute("href");
        if (!id || id.length < 2) return;
        const el = document.querySelector(id);
        if (!el) return;
        e.preventDefault();
        el.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
  }

  document.addEventListener("turbo:load", initBpFooterSmoothScroll);
  document.addEventListener("DOMContentLoaded", initBpFooterSmoothScroll);
</script>

<script nonce="<%= content_security_policy_nonce %>">
  function initBpGalleryModal() {
    const modalEl = document.getElementById("bpGalleryModal");
    const imgEl   = document.getElementById("bpGalleryImg");
    const titleEl = document.getElementById("bpGalleryTitle");
    if (!modalEl || !imgEl || !titleEl) return;

    // Bind clicks for signature plate tiles (and any future gallery tiles)
    document.querySelectorAll('[data-bp-src][data-bs-target="#bpGalleryModal"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();

        const src = link.getAttribute("data-bp-src");
        const title = link.getAttribute("data-bp-title") || "Photo";

        titleEl.textContent = title;
        imgEl.src = src;
        imgEl.alt = title;

        // Prefer Bootstrap JS if present
        if (window.bootstrap && window.bootstrap.Modal) {
          window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
          return;
        }

        // Fallback (if bootstrap JS truly isn't loaded)
        modalEl.classList.add("show");
        modalEl.style.display = "block";
        modalEl.removeAttribute("aria-hidden");
        document.body.classList.add("modal-open");
      });
    });

    // Clear image on close (prevents stale image on next open)
    modalEl.addEventListener("hidden.bs.modal", () => {
      imgEl.removeAttribute("src");
    });

    // Fallback close support if bootstrap isn't loaded
    modalEl.querySelectorAll("[data-bs-dismiss='modal']").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (window.bootstrap && window.bootstrap.Modal) return;
        modalEl.classList.remove("show");
        modalEl.style.display = "none";
        modalEl.setAttribute("aria-hidden", "true");
        document.body.classList.remove("modal-open");
        imgEl.removeAttribute("src");
      });
    });
  }

  document.addEventListener("turbo:load", initBpGalleryModal);
  document.addEventListener("DOMContentLoaded", initBpGalleryModal);
</script>

<script nonce="<%= content_security_policy_nonce %>">
  function initBpFadeCarousels() {
    document.querySelectorAll("[data-bp-fade-carousel]").forEach((root) => {
      const slides = Array.from(root.querySelectorAll(".bp-fade-slide"));
      if (slides.length < 2) return;

      // avoid double-init on Turbo visits
      if (root.dataset.bpInited === "1") return;
      root.dataset.bpInited = "1";

      const interval = parseInt(root.dataset.interval || "6500", 10);
      let idx = slides.findIndex((s) => s.classList.contains("is-active"));
      if (idx < 0) idx = 0;

      // ensure only one active
      slides.forEach((s, i) => s.classList.toggle("is-active", i === idx));

      setInterval(() => {
        const next = (idx + 1) % slides.length;
        slides[idx].classList.remove("is-active");
        slides[next].classList.add("is-active");
        idx = next;
      }, interval);
    });
  }

  document.addEventListener("turbo:load", initBpFadeCarousels);
  document.addEventListener("DOMContentLoaded", initBpFadeCarousels);
</script>
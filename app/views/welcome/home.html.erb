      <div>
        <h2 class="bp-h2 text-white mb-2">Menu Highlights</h2>
        <p class="bp-copy text-white-50 mb-0">
          A curated preview from our full menu, built for shareable starts, prime cuts, and a sweet finish.
        </p>
      </div>

      <div class="bp-tabs btn-group" role="group" aria-label="Menu tabs">
        <% @menu_sections.each_with_index do |sec, idx| %>
          <button
            class="btn <%= idx == 0 ? "btn-light" : "btn-outline-light" %>"
            type="button"
            data-bp-tab="<%= sec[:key] %>">
            <%= sec[:title] %>
          </button>
        <% end %>
      </div>
    </div>

    <% @menu_sections.each_with_index do |sec, idx| %>
      <div class="bp-menu-panel <%= idx == 0 ? "" : "d-none" %>" data-bp-panel="<%= sec[:key] %>">
        <div class="row g-3">
          <% sec[:items].each do |item| %>
            <div class="col-md-6 col-lg-4">
              <div class="bp-card bp-menu-item h-100">
                <div class="d-flex justify-content-between align-items-start gap-3">
                  <div class="bp-menu-title"><%= item[:name] %></div>
                  <div class="bp-menu-price">$<%= item[:price] %></div>
                </div>

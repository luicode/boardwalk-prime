<h1>New Boardwalk Prime email signup</h1>

<p>
  <strong>Email:</strong>
  <%= @email_signup.email %>
</p>

<p>
  <strong>Submitted:</strong>
  <%= @email_signup.created_at.to_fs(:long) %>
</p>

<% if @email_signup.ip_address.present? %>
  <p>
    <strong>IP address:</strong>
    <%= @email_signup.ip_address %>
  </p>
<% end %>

<% if @email_signup.user_agent.present? %>
  <p>
    <strong>User agent:</strong>
    <%= @email_signup.user_agent %>
  </p>
<% end %>
